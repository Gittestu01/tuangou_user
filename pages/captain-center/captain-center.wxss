/* pages/captain-center/captain-center.wxss */
.captain-center-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20px;
}

/* 数据总览 */
.overview-section {
  background-color: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
}

.overview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.overview-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.overview-period {
  font-size: 14px;
  color: #666;
}

.overview-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
  position: relative;
}

.stat-value {
  font-size: 24px;
  font-weight: 700;
  color: #ff6b35;
  margin-bottom: 4px;
}

.stat-label {
  font-size: 12px;
  color: #666;
  margin-bottom: 8px;
}

.stat-change {
  font-size: 10px;
  font-weight: 500;
}

.stat-change.positive {
  color: #28a745;
}

.stat-change.negative {
  color: #dc3545;
}

/* 快速操作 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-bottom: 20px;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
  background-color: #fff;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.action-icon {
  font-size: 24px;
  margin-bottom: 8px;
}

.action-text {
  font-size: 12px;
  color: #333;
  font-weight: 500;
}

/* 我的开团 */
.my-groups-section {
  background-color: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 14px;
  color: #ff6b35;
}

.groups-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.group-item {
  display: flex;
  align-items: flex-start;
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.group-image {
  width: 80px;
  height: 80px;
  border-radius: 6px;
  margin-right: 15px;
}

.group-info {
  flex: 1;
  margin-right: 15px;
}

.group-title {
  display: block;
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.group-price {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.price {
  font-size: 16px;
  font-weight: 600;
  color: #ff6b35;
  margin-right: 8px;
}

.price-original {
  font-size: 12px;
  color: #999;
  text-decoration: line-through;
}

.group-progress {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.progress-bar {
  flex: 1;
  height: 6px;
  background-color: #e9ecef;
  border-radius: 3px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #ff6b35;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 12px;
  color: #666;
  white-space: nowrap;
}

.group-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-status {
  font-size: 12px;
  font-weight: 500;
  padding: 2px 6px;
  border-radius: 4px;
}

.group-status.active {
  background-color: #d4edda;
  color: #155724;
}

.group-status.completed {
  background-color: #cce5ff;
  color: #004085;
}

.group-status.expired {
  background-color: #f8d7da;
  color: #721c24;
}

.group-time {
  font-size: 12px;
  color: #999;
}

.group-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.action-btn {
  padding: 6px 12px;
  border: 1px solid #ddd;
  border-radius: 4px;
  background-color: #fff;
  font-size: 12px;
  color: #333;
}

.action-btn.primary {
  background-color: #ff6b35;
  color: #fff;
  border-color: #ff6b35;
}

.action-btn.secondary {
  background-color: #f8f9fa;
  color: #666;
  border-color: #e9ecef;
}

/* 待处理订单 */
.pending-orders-section {
  background-color: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
}

.orders-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.order-item {
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.order-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.order-id {
  font-size: 14px;
  color: #666;
}

.order-status {
  font-size: 12px;
  color: #ff6b35;
  font-weight: 500;
}

.order-content {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
}

.order-image {
  width: 60px;
  height: 60px;
  border-radius: 6px;
  margin-right: 15px;
}

.order-info {
  flex: 1;
}

.order-title {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.order-quantity,
.order-amount,
.order-customer {
  font-size: 12px;
  color: #666;
  margin-bottom: 2px;
}

.order-actions {
  display: flex;
  gap: 10px;
}

/* 业绩趋势 */
.performance-trend-section {
  background-color: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
}

.trend-chart {
  margin-bottom: 20px;
}

.chart-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 120px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.chart-text {
  font-size: 16px;
  color: #666;
  margin-bottom: 4px;
}

.chart-desc {
  font-size: 12px;
  color: #999;
}

.trend-stats {
  display: flex;
  justify-content: space-around;
}

.trend-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.trend-label {
  font-size: 12px;
  color: #666;
  margin-bottom: 4px;
}

.trend-value {
  font-size: 16px;
  font-weight: 600;
  color: #ff6b35;
}

/* 提货核销 */
.pickup-section {
  background-color: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
}

.pickup-actions {
  display: flex;
  gap: 15px;
  margin-bottom: 20px;
}

.pickup-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 15px;
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 500;
}

.btn-icon {
  font-size: 16px;
}

.btn-text {
  font-size: 14px;
}

.pickup-stats {
  display: flex;
  justify-content: space-around;
}

.pickup-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pickup-value {
  font-size: 18px;
  font-weight: 600;
  color: #ff6b35;
  margin-bottom: 4px;
}

.pickup-label {
  font-size: 12px;
  color: #666;
}
