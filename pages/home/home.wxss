/* pages/home/home.wxss */
.home-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 搜索栏样式 */
.search-bar {
  background-color: #fff;
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.search-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #f8f9fa;
  padding: 10px 15px;
  border-radius: 20px;
  border: 1px solid #e9ecef;
}

.search-placeholder {
  color: #999;
  font-size: 14px;
}

.search-icon {
  font-size: 16px;
  color: #666;
}

/* 定位栏样式 */
.location-bar {
  background-color: #fff;
  padding: 10px 15px;
  border-bottom: 1px solid #f0f0f0;
}

.location-info {
  display: flex;
  align-items: center;
}

.location-icon {
  font-size: 14px;
  margin-right: 5px;
}

.location-text {
  font-size: 14px;
  color: #333;
  flex: 1;
}

.location-arrow {
  font-size: 12px;
  color: #999;
}

/* Banner轮播样式 */
.banner-section {
  margin: 10px 15px;
  border-radius: 8px;
  overflow: hidden;
}

.banner-swiper {
  height: 160px;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 区块样式 */
.section {
  background-color: #fff;
  margin: 10px 0;
  padding: 15px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 14px;
  color: #ff6b35;
}

/* 开团列表样式 */
.group-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.group-item {
  display: flex;
  background-color: #f8f9fa;
  border-radius: 8px;
  padding: 15px;
  border: 1px solid #e9ecef;
}

.group-image {
  width: 80px;
  height: 80px;
  border-radius: 6px;
  margin-right: 15px;
}

.group-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.group-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.group-price {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.price {
  font-size: 18px;
  font-weight: 600;
  color: #ff6b35;
}

.price-original {
  font-size: 14px;
  color: #999;
  text-decoration: line-through;
  margin-left: 8px;
}

.group-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.group-countdown {
  font-size: 12px;
  color: #ff6b35;
  font-weight: 500;
}

.group-captain {
  font-size: 12px;
  color: #666;
}

.group-progress {
  display: flex;
  align-items: center;
  gap: 10px;
}

.progress-bar {
  flex: 1;
  height: 6px;
  background-color: #e9ecef;
  border-radius: 3px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #ff6b35;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 12px;
  color: #666;
  white-space: nowrap;
}

/* 附近团购样式 */
.nearby-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.nearby-item {
  display: flex;
  background-color: #f8f9fa;
  border-radius: 8px;
  padding: 15px;
  border: 1px solid #e9ecef;
}

.nearby-image {
  width: 80px;
  height: 80px;
  border-radius: 6px;
  margin-right: 15px;
}

.nearby-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.nearby-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.nearby-price {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.nearby-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nearby-distance {
  font-size: 12px;
  color: #666;
}

.nearby-captain {
  font-size: 12px;
  color: #666;
}

/* 加载更多样式 */
.loading-more {
  text-align: center;
  padding: 20px;
  color: #666;
  font-size: 14px;
}
