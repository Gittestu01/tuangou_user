/* pages/product-detail/product-detail.wxss */
.product-detail-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 80px;
}

/* 商品媒体展示区 */
.product-media {
  background-color: #fff;
  margin-bottom: 10px;
}

.product-swiper {
  height: 300px;
}

.product-image {
  width: 100%;
  height: 100%;
}

/* 商品基本信息 */
.product-info {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 10px;
}

.product-title {
  font-size: 20px;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8px;
}

.product-subtitle {
  font-size: 14px;
  color: #666;
  line-height: 1.4;
  margin-bottom: 15px;
}

.product-price {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.price {
  font-size: 28px;
  font-weight: 700;
  color: #ff6b35;
  margin-right: 10px;
}

.price-original {
  font-size: 16px;
  color: #999;
  text-decoration: line-through;
  margin-right: 10px;
}

.discount-tag {
  background-color: #ff6b35;
  color: #fff;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 500;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20px;
}

.meta-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meta-label {
  font-size: 12px;
  color: #999;
  margin-bottom: 4px;
}

.meta-value {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

.countdown {
  color: #ff6b35;
}

.group-progress {
  margin-top: 15px;
}

.progress-bar {
  height: 8px;
  background-color: #e9ecef;
  border-radius: 4px;
  overflow: hidden;
  margin-bottom: 8px;
}

.progress-fill {
  height: 100%;
  background-color: #ff6b35;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 14px;
  color: #666;
  text-align: center;
}

/* 团长信息 */
.captain-info {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 10px;
}

.captain-header {
  margin-bottom: 15px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.captain-card {
  display: flex;
  align-items: center;
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.captain-avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  margin-right: 15px;
}

.captain-details {
  flex: 1;
}

.captain-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.captain-address {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.captain-stats {
  display: flex;
  gap: 15px;
}

.stat-item {
  font-size: 12px;
  color: #999;
}

.captain-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

/* 商品详情 */
.product-details {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 10px;
}

.details-header {
  margin-bottom: 15px;
}

.details-content {
  line-height: 1.6;
  color: #333;
}

/* 参团用户列表 */
.joiners-list {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 10px;
}

.joiners-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.joiners-count {
  font-size: 14px;
  color: #666;
}

.joiners-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
}

.joiner-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.joiner-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  margin-bottom: 8px;
}

.joiner-name {
  font-size: 12px;
  color: #333;
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

.joiner-time {
  font-size: 10px;
  color: #999;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 15px 20px;
  border-top: 1px solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.action-left {
  display: flex;
  gap: 20px;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: none;
  border: none;
  padding: 0;
  font-size: 12px;
  color: #666;
}

.action-icon {
  font-size: 20px;
  margin-bottom: 4px;
}

.action-text {
  font-size: 12px;
}

.action-right {
  flex: 1;
  margin-left: 20px;
}

.btn {
  width: 100%;
}
