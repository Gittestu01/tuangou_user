/* pages/cart/cart.wxss */
.cart-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 80px;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 20px;
  text-align: center;
}

.empty-icon {
  font-size: 80px;
  margin-bottom: 20px;
  opacity: 0.5;
}

.empty-text {
  font-size: 18px;
  color: #666;
  margin-bottom: 8px;
}

.empty-desc {
  font-size: 14px;
  color: #999;
  margin-bottom: 30px;
}

.empty-btn {
  padding: 12px 24px;
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  font-weight: 500;
}

/* 全选操作栏 */
.select-all-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 20px;
  background-color: #fff;
  border-bottom: 1px solid #f0f0f0;
}

.select-all {
  display: flex;
  align-items: center;
}

.select-checkbox {
  transform: scale(0.8);
  margin-right: 8px;
}

.select-text {
  font-size: 14px;
  color: #333;
}

.delete-btn {
  padding: 6px 12px;
  background-color: #ff4757;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 12px;
}

/* 购物车列表 */
.cart-items {
  background-color: #fff;
  margin-bottom: 20px;
}

.cart-item {
  display: flex;
  align-items: flex-start;
  padding: 15px 20px;
  border-bottom: 1px solid #f0f0f0;
}

.cart-item:last-child {
  border-bottom: none;
}

.item-checkbox {
  margin-right: 15px;
  margin-top: 5px;
}

.item-check {
  transform: scale(0.8);
}

.item-image {
  width: 80px;
  height: 80px;
  border-radius: 6px;
  margin-right: 15px;
}

.item-info {
  flex: 1;
}

.item-title {
  display: block;
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-subtitle {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.item-price {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.price {
  font-size: 18px;
  font-weight: 600;
  color: #ff6b35;
  margin-right: 8px;
}

.price-original {
  font-size: 14px;
  color: #999;
  text-decoration: line-through;
}

.item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.item-captain {
  font-size: 12px;
  color: #666;
}

.item-countdown {
  font-size: 12px;
  color: #ff6b35;
  font-weight: 500;
}

.item-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 10px;
}

.quantity-btn {
  width: 30px;
  height: 30px;
  border: 1px solid #ddd;
  border-radius: 4px;
  background-color: #fff;
  font-size: 16px;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quantity-btn:disabled {
  background-color: #f5f5f5;
  color: #ccc;
  border-color: #e9ecef;
}

.quantity-value {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  min-width: 30px;
  text-align: center;
}

.delete-item-btn {
  padding: 6px 12px;
  background-color: #ff4757;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 12px;
}

/* 推荐商品 */
.recommend-section {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 20px;
}

.section-header {
  margin-bottom: 15px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.recommend-item {
  display: flex;
  align-items: center;
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.recommend-image {
  width: 60px;
  height: 60px;
  border-radius: 6px;
  margin-right: 15px;
}

.recommend-info {
  flex: 1;
  margin-right: 15px;
}

.recommend-title {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #333;
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.recommend-price {
  display: flex;
  align-items: center;
}

.add-cart-btn {
  padding: 8px 16px;
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 12px;
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 15px 20px;
  border-top: 1px solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.bar-left {
  display: flex;
  align-items: center;
}

.bar-center {
  flex: 1;
  text-align: center;
  margin: 0 20px;
}

.total-label {
  font-size: 14px;
  color: #666;
}

.total-amount {
  font-size: 18px;
  font-weight: 700;
  color: #ff6b35;
  margin-left: 5px;
}

.points-deduction {
  font-size: 12px;
  color: #ff6b35;
  margin-left: 5px;
}

.checkout-btn {
  padding: 12px 24px;
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  font-weight: 500;
}

.checkout-btn:disabled {
  background-color: #ccc;
  color: #999;
}
