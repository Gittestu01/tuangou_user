/* pages/profile/profile.wxss */
.profile-container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 用户信息头部 */
.user-header {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 10px;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  margin-right: 15px;
}

.user-details {
  flex: 1;
}

.login-text {
  display: block;
  font-size: 18px;
  font-weight: 600;
  color: #333;
  margin-bottom: 4px;
}

.login-desc {
  font-size: 14px;
  color: #666;
}

.user-name {
  display: block;
  font-size: 18px;
  font-weight: 600;
  color: #333;
  margin-bottom: 4px;
}

.user-level {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.user-stats {
  display: flex;
  gap: 15px;
}

.stat-item {
  font-size: 12px;
  color: #999;
}

.login-arrow,
.edit-arrow {
  font-size: 16px;
  color: #999;
}

/* 订单管理 */
.order-section {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 10px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 14px;
  color: #ff6b35;
}

.order-stats {
  display: flex;
  justify-content: space-around;
}

.order-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.order-icon {
  font-size: 24px;
  margin-bottom: 8px;
}

.order-label {
  font-size: 12px;
  color: #666;
}

.order-count {
  position: absolute;
  top: -5px;
  right: -5px;
  background-color: #ff6b35;
  color: #fff;
  font-size: 10px;
  padding: 2px 6px;
  border-radius: 8px;
  min-width: 16px;
  text-align: center;
}

/* 功能菜单 */
.menu-section {
  margin-bottom: 10px;
}

.menu-group {
  background-color: #fff;
  margin-bottom: 10px;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 15px 20px;
  border-bottom: 1px solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 20px;
  margin-right: 15px;
}

.menu-text {
  flex: 1;
  font-size: 16px;
  color: #333;
}

.menu-arrow {
  font-size: 16px;
  color: #999;
}

/* 团长入口 */
.captain-section {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 10px;
}

.captain-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  background: linear-gradient(135deg, #ff6b35, #ff8c42);
  border-radius: 8px;
  color: #fff;
}

.captain-content {
  display: flex;
  align-items: center;
}

.captain-icon {
  font-size: 24px;
  margin-right: 15px;
}

.captain-info {
  display: flex;
  flex-direction: column;
}

.captain-title {
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 4px;
}

.captain-desc {
  font-size: 12px;
  opacity: 0.9;
}

.captain-arrow {
  font-size: 16px;
}

/* 团长功能入口 */
.captain-functions {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 10px;
}

.function-header {
  margin-bottom: 15px;
}

.function-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15px;
}

.function-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.function-icon {
  font-size: 24px;
  margin-bottom: 8px;
}

.function-text {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

/* 设置 */
.settings-section {
  background-color: #fff;
  padding: 20px;
  margin-bottom: 10px;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 15px 0;
}

.settings-icon {
  font-size: 20px;
  margin-right: 15px;
}

.settings-text {
  flex: 1;
  font-size: 16px;
  color: #333;
}

.settings-arrow {
  font-size: 16px;
  color: #999;
}
