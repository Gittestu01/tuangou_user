/* pages/order-confirm/order-confirm.wxss */
.order-confirm-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120px;
}

/* 通用区块样式 */
.product-section,
.delivery-section,
.address-section,
.captain-section,
.points-section,
.payment-section,
.agreement-section {
  background-color: #fff;
  margin-bottom: 10px;
  padding: 20px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
}

.section-action {
  font-size: 14px;
  color: #ff6b35;
}

/* 商品信息样式 */
.product-item {
  display: flex;
  align-items: center;
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.product-image {
  width: 80px;
  height: 80px;
  border-radius: 6px;
  margin-right: 15px;
}

.product-info {
  flex: 1;
  margin-right: 15px;
}

.product-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-subtitle {
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.product-price {
  display: flex;
  align-items: center;
}

.price {
  font-size: 18px;
  font-weight: 600;
  color: #ff6b35;
  margin-right: 8px;
}

.price-original {
  font-size: 14px;
  color: #999;
  text-decoration: line-through;
}

.product-quantity {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quantity-label {
  font-size: 12px;
  color: #666;
  margin-bottom: 8px;
}

.quantity-controls {
  display: flex;
  align-items: center;
  gap: 10px;
}

.quantity-btn {
  width: 30px;
  height: 30px;
  border: 1px solid #ddd;
  border-radius: 4px;
  background-color: #fff;
  font-size: 16px;
  color: #333;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quantity-btn:disabled {
  background-color: #f5f5f5;
  color: #ccc;
  border-color: #e9ecef;
}

.quantity-value {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  min-width: 30px;
  text-align: center;
}

/* 收货方式样式 */
.delivery-options {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.delivery-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  border: 1px solid #e9ecef;
  border-radius: 8px;
  background-color: #f8f9fa;
}

.delivery-option.active {
  border-color: #ff6b35;
  background-color: #fff5f2;
}

.option-content {
  display: flex;
  align-items: center;
}

.option-icon {
  font-size: 20px;
  margin-right: 10px;
}

.option-info {
  display: flex;
  flex-direction: column;
}

.option-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.option-desc {
  font-size: 14px;
  color: #666;
}

.option-check {
  font-size: 18px;
  color: #ff6b35;
  font-weight: 600;
}

/* 地址样式 */
.address-item {
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.address-info {
  display: flex;
  flex-direction: column;
}

.address-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.address-phone {
  font-size: 14px;
  color: #666;
  margin-bottom: 4px;
}

.address-detail {
  font-size: 14px;
  color: #666;
}

.address-placeholder {
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px dashed #ddd;
  text-align: center;
}

.placeholder-text {
  font-size: 14px;
  color: #999;
}

/* 团长信息样式 */
.captain-item {
  display: flex;
  align-items: center;
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
}

.captain-avatar {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  margin-right: 15px;
}

.captain-info {
  flex: 1;
}

.captain-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.captain-address {
  font-size: 14px;
  color: #666;
  margin-bottom: 4px;
}

.captain-phone {
  font-size: 14px;
  color: #666;
}

.contact-btn {
  padding: 8px 16px;
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 4px;
  font-size: 14px;
}

/* 积分抵扣样式 */
.points-balance {
  font-size: 14px;
  color: #666;
}

.points-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  background-color: #f8f9fa;
  border-radius: 8px;
  border: 1px solid #e9ecef;
  margin-bottom: 10px;
}

.points-info {
  display: flex;
  flex-direction: column;
}

.points-label {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 4px;
}

.points-desc {
  font-size: 12px;
  color: #666;
}

.points-controls {
  display: flex;
  align-items: center;
  gap: 8px;
}

.points-input {
  width: 80px;
  padding: 8px 12px;
  border: 1px solid #ddd;
  border-radius: 4px;
  text-align: center;
  font-size: 14px;
}

.points-unit {
  font-size: 14px;
  color: #666;
}

.points-deduction {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 15px;
  background-color: #fff5f2;
  border-radius: 6px;
  border: 1px solid #ff6b35;
}

.deduction-label {
  font-size: 14px;
  color: #333;
}

.deduction-amount {
  font-size: 16px;
  font-weight: 600;
  color: #ff6b35;
}

/* 支付方式样式 */
.payment-options {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.payment-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px;
  border: 1px solid #e9ecef;
  border-radius: 8px;
  background-color: #f8f9fa;
}

.payment-option.active {
  border-color: #ff6b35;
  background-color: #fff5f2;
}

/* 协议样式 */
.agreement-item {
  display: flex;
  align-items: center;
  gap: 8px;
}

.agreement-checkbox {
  transform: scale(0.8);
}

.agreement-text {
  font-size: 14px;
  color: #666;
}

.agreement-link {
  font-size: 14px;
  color: #ff6b35;
}

/* 底部订单信息 */
.bottom-summary {
  position: fixed;
  bottom: 60px;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 15px 20px;
  border-top: 1px solid #f0f0f0;
  z-index: 100;
}

.summary-details {
  margin-bottom: 10px;
}

.summary-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 5px;
}

.summary-label {
  font-size: 14px;
  color: #666;
}

.summary-value {
  font-size: 14px;
  color: #333;
}

.summary-value.deduction {
  color: #ff6b35;
}

.summary-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 10px;
  border-top: 1px solid #f0f0f0;
}

.total-label {
  font-size: 16px;
  font-weight: 500;
  color: #333;
}

.total-amount {
  font-size: 20px;
  font-weight: 700;
  color: #ff6b35;
}

/* 底部确认按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 15px 20px;
  border-top: 1px solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
}

.actions-left {
  display: flex;
  align-items: center;
  gap: 5px;
}

.confirm-btn {
  padding: 12px 32px;
  background-color: #ff6b35;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  font-weight: 500;
}

.confirm-btn:disabled {
  background-color: #ccc;
  color: #999;
}
