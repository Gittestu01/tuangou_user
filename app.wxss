/* app.wxss - 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue', sans-serif;
  font-size: 14px;
  color: #333;
}

/* 通用容器 */
.container {
  padding: 0 15px;
}

/* 通用卡片样式 */
.card {
  background: #fff;
  border-radius: 8px;
  padding: 15px;
  margin-bottom: 10px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

/* 通用按钮样式 */
.btn {
  padding: 12px 24px;
  border-radius: 6px;
  text-align: center;
  font-size: 16px;
  font-weight: 500;
  border: none;
  cursor: pointer;
}

.btn-primary {
  background-color: #ff6b35;
  color: #fff;
}

.btn-primary:hover {
  background-color: #e55a2b;
}

.btn-secondary {
  background-color: #f8f9fa;
  color: #666;
  border: 1px solid #dee2e6;
}

.btn-secondary:hover {
  background-color: #e9ecef;
}

.btn-small {
  padding: 8px 16px;
  font-size: 14px;
}

.btn-large {
  padding: 16px 32px;
  font-size: 18px;
}

/* 通用输入框样式 */
.input {
  padding: 12px 15px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 14px;
  background-color: #fff;
}

.input:focus {
  border-color: #ff6b35;
  outline: none;
}

/* 通用标签样式 */
.tag {
  display: inline-block;
  padding: 4px 8px;
  background-color: #ff6b35;
  color: #fff;
  border-radius: 4px;
  font-size: 12px;
  margin-right: 5px;
}

.tag-secondary {
  background-color: #6c757d;
}

.tag-success {
  background-color: #28a745;
}

.tag-warning {
  background-color: #ffc107;
  color: #333;
}

/* 通用列表样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 15px 0;
  border-bottom: 1px solid #f0f0f0;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-content {
  flex: 1;
}

.list-item-title {
  font-size: 16px;
  font-weight: 500;
  color: #333;
  margin-bottom: 5px;
}

.list-item-desc {
  font-size: 14px;
  color: #666;
}

.list-item-action {
  margin-left: 15px;
}

/* 通用头像样式 */
.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: #ddd;
}

.avatar-large {
  width: 60px;
  height: 60px;
}

.avatar-small {
  width: 30px;
  height: 30px;
}

/* 通用价格样式 */
.price {
  color: #ff6b35;
  font-weight: 600;
}

.price-original {
  color: #999;
  text-decoration: line-through;
  margin-left: 5px;
}

/* 通用倒计时样式 */
.countdown {
  color: #ff6b35;
  font-weight: 500;
}

/* 通用加载状态 */
.loading {
  text-align: center;
  padding: 20px;
  color: #666;
}

/* 通用空状态 */
.empty {
  text-align: center;
  padding: 40px 20px;
  color: #999;
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 15px;
}

.empty-text {
  font-size: 16px;
}

/* 通用分割线 */
.divider {
  height: 1px;
  background-color: #f0f0f0;
  margin: 15px 0;
}

/* 通用间距 */
.mt-10 { margin-top: 10px; }
.mt-15 { margin-top: 15px; }
.mt-20 { margin-top: 20px; }
.mb-10 { margin-bottom: 10px; }
.mb-15 { margin-bottom: 15px; }
.mb-20 { margin-bottom: 20px; }
.ml-10 { margin-left: 10px; }
.mr-10 { margin-right: 10px; }

/* 通用对齐 */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

/* 通用弹性布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* 通用定位 */
.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.fixed {
  position: fixed;
}

/* 通用显示隐藏 */
.hidden {
  display: none;
}

.visible {
  display: block;
}
